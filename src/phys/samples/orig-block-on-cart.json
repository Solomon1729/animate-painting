{
 "id": "orig-block-on-cart",
 "title": "台車の上をすべる物体",
 "tags": [
  "力学",
  "運動量",
  "摩擦"
 ],
 "source": "オリジナル（運動量保存と摩擦熱の型）",
 "level": "standard",
 "problem": "なめらかな水平面上の質量{M}kgの台車の左端に、質量{m}kgの物体を速さ{v0}m/sで乗せる。物体と台車のあいだの動摩擦係数は{mu}。",
 "params": {
  "m": {
   "v": 1,
   "min": 0.5,
   "max": 3,
   "step": 0.5,
   "unit": "kg",
   "label": "物体の質量"
  },
  "M": {
   "v": 3,
   "min": 1,
   "max": 6,
   "step": 0.5,
   "unit": "kg",
   "label": "台車の質量"
  },
  "v0": {
   "v": 4,
   "min": 1,
   "max": 8,
   "step": 0.5,
   "unit": "m/s",
   "label": "物体の初速"
  },
  "mu": {
   "v": 0.3,
   "min": 0.1,
   "max": 0.6,
   "step": 0.05,
   "label": "動摩擦係数"
  }
 },
 "vars": {
  "Lc": "3.0",
  "hc": "0.1",
  "wb": "0.3",
  "hb": "0.2",
  "vf": "m*v0/(m+M)",
  "d": "M*v0^2/(2*mu*g*(m+M))",
  "ts": "M*v0/(mu*g*(m+M))",
  "rel0": "-Lc/2+wb/2"
 },
 "view": {
  "x0": -2.5,
  "y0": -0.3,
  "w": 8.0
 },
 "bodies": [
  {
   "id": "floor",
   "type": "static",
   "mu": 0,
   "shapes": [
    {
     "t": "plane",
     "normal": [
      0,
      1
     ],
     "d": 0
    }
   ]
  },
  {
   "id": "cart",
   "type": "dynamic",
   "m": "M",
   "mu": 0.3,
   "fixedRot": true,
   "pos": [
    0,
    "hc/2"
   ],
   "label": "台車",
   "shapes": [
    {
     "t": "box",
     "w": "Lc",
     "h": "hc"
    }
   ]
  },
  {
   "id": "blk",
   "type": "dynamic",
   "m": "m",
   "mu": 0.3,
   "fixedRot": true,
   "pos": [
    "rel0",
    "hc+hb/2"
   ],
   "vel": [
    "v0",
    0
   ],
   "label": "物体",
   "shapes": [
    {
     "t": "box",
     "w": "wb",
     "h": "hb"
    }
   ]
  }
 ],
 "pairs": [
  {
   "a": "blk",
   "b": "cart",
   "mu": "mu"
  },
  {
   "a": "cart",
   "b": "floor",
   "mu": 0
  },
  {
   "a": "blk",
   "b": "floor",
   "mu": 0
  }
 ],
 "probes": {
  "vb": {
   "expr": "blk.vx",
   "reduce": "last",
   "unit": "m/s",
   "label": "最終の物体の速度"
  },
  "vc": {
   "expr": "cart.vx",
   "reduce": "last",
   "unit": "m/s",
   "label": "最終の台車の速度"
  },
  "slide": {
   "expr": "(blk.x-cart.x)-rel0",
   "reduce": "last",
   "unit": "m",
   "label": "台車に対してすべった距離"
  },
  "Px": {
   "expr": "Px",
   "reduce": "last",
   "unit": "kg·m/s",
   "label": "全運動量"
  },
  "Q": {
   "expr": "KE",
   "reduce": "first",
   "unit": "J",
   "label": "はじめの運動エネルギー"
  },
  "Ke": {
   "expr": "KE",
   "reduce": "last",
   "unit": "J",
   "label": "あとの運動エネルギー"
  },
  "t_stop": {
   "expr": "t",
   "when": "abs(blk.vx-cart.vx)<0.01",
   "reduce": "first",
   "unit": "s",
   "label": "すべり終わる時刻"
  }
 },
 "run": {
  "t": "ts+1.0"
 },
 "ask": [
  {
   "q": "最終の速度（物体） m v0/(m+M)",
   "probe": "vb",
   "theory": "vf",
   "unit": "m/s",
   "tol": 0.003
  },
  {
   "q": "最終の速度（台車）",
   "probe": "vc",
   "theory": "vf",
   "unit": "m/s",
   "tol": 0.003
  },
  {
   "q": "すべった距離 M v0²/(2μg(m+M))",
   "probe": "slide",
   "theory": "d",
   "unit": "m",
   "tol": 0.01
  },
  {
   "q": "すべり終わる時刻 M v0/(μg(m+M))",
   "probe": "t_stop",
   "theory": "ts",
   "unit": "s",
   "tol": 0.02
  },
  {
   "q": "摩擦熱＝失われた運動エネルギー μ m g d",
   "expr": "Q-Ke",
   "theory": "mu*m*g*d",
   "unit": "J",
   "tol": 0.01
  }
 ],
 "checks": [
  {
   "name": "全運動量の保存",
   "probe": "Px",
   "conserved": 0.0001,
   "scale": "m*v0"
  }
 ]
}
