   "type": "static",
   "pos": [
    0,
    0
   ],
   "shapes": [
    {
     "t": "box",
     "w": 0.06,
     "h": 0.6,
     "ox": -0.03,
     "oy": 0.3
    }
   ],
   "mu": 0
  },
  {
   "id": "blk",
   "type": "dynamic",
   "m": "m",
   "mu": 0,
   "fixedRot": true,
   "pos": [
    "l0+A+hb",
    "hb"
   ],
   "label": "物体",
   "shapes": [
    {
     "t": "box",
     "w": 0.3,
     "h": 0.3
    }
   ]
  }
 ],
 "joints": [
  {
   "id": "sp",
   "type": "spring",
   "a": {
    "at": [
