     0
    ]
   },
   "k": "k",
   "len": "l0"
  }
 ],
 "probes": {
  "T": {
   "expr": "blk.x",
   "reduce": "period",
   "unit": "s",
   "label": "周期"
  },
  "xamp": {
   "expr": "blk.x",
   "reduce": "amp",
   "unit": "m",
   "label": "振幅"
  },
  "vmax": {
   "expr": "blk.speed",
   "reduce": "max",
   "unit": "m/s",
   "label": "最大の速さ"
  },
  "Fmax": {
   "expr": "abs(sp.F)",
   "reduce": "max",
   "unit": "N",
   "label": "ばねの力の最大値"
  },
  "E": {
   "expr": "E",
   "reduce": "last",
   "unit": "J",
   "label": "力学的エネルギー"
  }
 },
 "run": {
  "t": 4.0
 },
 "ask": [
  {
   "q": "周期 2π√(m/k)",
   "probe": "T",
   "theory": "T",
   "unit": "s",
   "tol": 0.003
  },
  {
   "q": "振幅 A",
