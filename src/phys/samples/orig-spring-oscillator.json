 "source": "オリジナル（水平ばね振り子の型）",
 "level": "basic",
 "problem": "なめらかな水平面上で、質量{m}kgの物体が、ばね定数{k}N/mのばね（自然の長さ{l0}m）で壁につながれている。ばねを{A}mだけ伸ばして静かに放す。",
 "params": {
  "m": {
   "v": 0.5,
   "min": 0.1,
   "max": 2,
   "step": 0.1,
   "unit": "kg",
   "label": "質量"
  },
  "k": {
   "v": 20,
   "min": 5,
   "max": 60,
   "step": 1,
   "unit": "N/m",
   "label": "ばね定数"
  },
