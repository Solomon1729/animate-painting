   "v": 0.3,
   "min": 0.05,
   "max": 0.6,
   "step": 0.05,
   "unit": "m",
   "label": "はじめの伸び"
  }
 },
 "vars": {
  "l0": "1.0",
  "hb": "0.15",
  "T": "2*pi*sqrt(m/k)",
  "w": "sqrt(k/m)"
 },
 "view": {
  "x0": -0.3,
  "y0": -0.25,
  "w": 3.0
 },
